{
  "name": "@seat-booker/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, error codes and response shapes. Zero runtime dependencies.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node ./scripts/write-esm-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@seat-booker/tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  }
}
