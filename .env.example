# Copy to .env at the repo root is NOT used; each app has its own .env.
# This file documents every variable the stack needs.

# ---- apps/api/.env ----
# Port 5433: the Docker container is published on 5433 to avoid clashing with a
# locally installed Postgres that may already own 5432. See docker-compose.yml.
DATABASE_URL="postgresql://seatbooker:seatbooker@127.0.0.1:5433/seatbooker"
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Centre-local display timezone (dates are always STORED as UTC).
CENTRE_TIMEZONE="Asia/Colombo"
BCRYPT_ROUNDS=10

# ---- apps/web/.env ----
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_CENTRE_TIMEZONE="Asia/Colombo"
